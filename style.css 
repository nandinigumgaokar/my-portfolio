
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #f4f0ff;
  color: #29213d;
  line-height: 1.7;
  padding: 25px;
}

h1 {
  color: #6c3fc5;
  font-size: 32px;
  margin-bottom: 10px;
}

h2 {
  color: #6c3fc5;
  margin-top: 28px;
  margin-bottom: 10px;
}

p, li {
  font-size: 17px;
}

ul {
  padding-left: 25px;
}

p {
  margin-bottom: 12px;
}

body > h1:first-child {
  border-bottom: 3px solid #b69af0;
  padding-bottom: 12px;
}
