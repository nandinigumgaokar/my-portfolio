
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #0f172a;
    color: white;
    padding: 30px;
    line-height: 1.6;
}

h1 {
    color: #38bdf8;
    font-size: 36px;
    margin-bottom: 10px;
}

h2 {
    color: #7dd3fc;
    margin-top: 25px;
    margin-bottom: 10px;
}

p {
    font-size: 17px;
    color: #cbd5e1;
}

ul {
    padding-left: 25px;
}

li {
    margin: 8px 0;
}
body {
    max-width: 900px;
    margin: auto;
}

h1 {
    text-align: center;
    padding: 20px 0;
}

h2 {
    border-bottom: 2px solid #38bdf8;
    padding-bottom: 8px;
}

p {
    line-height: 1.8;
}

li {
    color: #38bdf8;
}

ul {
    margin-bottom: 20px;
}